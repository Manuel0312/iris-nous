# Example environment variables (copy to .env — never commit .env)
BCI_IOT_ENV=dev
BCI_IOT_SAMPLE_RATE_HZ=250
BCI_IOT_WINDOW_SECONDS=1.0
BCI_IOT_WINDOW_OVERLAP=0.5
BCI_IOT_SESSION_SECRET=change-me-in-production-local-dev
BCI_IOT_ADMIN_USERNAME=admin
BCI_IOT_ADMIN_PASSWORD=admin123
BCI_IOT_HOME_ASSISTANT_URL=
BCI_IOT_HOME_ASSISTANT_TOKEN=
BCI_IOT_SPOTIFY_CLIENT_ID=
BCI_IOT_SPOTIFY_CLIENT_SECRET=
BCI_IOT_SPOTIFY_REDIRECT_URI=https://iris-nous.onrender.com/auth/spotify/callback
BCI_IOT_PUBLIC_URL=https://iris-nous.onrender.com

# Mail Iris Nous (recupero password solo email). Consigliato Resend:
# BCI_IOT_RESEND_API_KEY=re_xxxxxxxx
# BCI_IOT_MAIL_FROM=noreply@iris-nous.app
# Oppure Gmail SMTP:
# BCI_IOT_SMTP_HOST=smtp.gmail.com
# BCI_IOT_SMTP_PORT=587
# BCI_IOT_SMTP_USER=tua@gmail.com
# BCI_IOT_SMTP_PASSWORD=password-per-le-app
# BCI_IOT_SMTP_FROM=tua@gmail.com
# In produzione senza codice a schermo:
# BCI_IOT_REQUIRE_REAL_OTP=1
